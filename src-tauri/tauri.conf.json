{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdminOps",
  "version": "1.1.9",
  "identifier": "com.adminops.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AdminOps",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#111315",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "David Bonilla",
    "copyright": "© 2026 David Bonilla",
    "shortDescription": "Diagnóstico y soporte técnico de Windows",
    "longDescription": "AdminOps: diagnóstico, optimización, reparación y soporte técnico de equipos Windows.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "resources": {
      "resources/lhm/*": "lhm/"
    }
  }
}
