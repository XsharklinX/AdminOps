{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdminOps",
  "version": "0.1.0",
  "identifier": "com.adminops.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AdminOps",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#07090d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
