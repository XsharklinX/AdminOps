{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instalar AdminOps",
  "version": "1.0.0",
  "identifier": "com.adminops.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Instalar AdminOps",
